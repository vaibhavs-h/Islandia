# local reference/scratch material
/temp/

# macOS
.DS_Store

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build/

# misc
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# auto-regenerated by `next dev` itself - not source, no need to track
AGENTS.md
CLAUDE.md

# --- app/ (Flutter macOS shell) ---
# Note: app/macos/.gitignore separately covers macos/Flutter/ephemeral/,
# macos/Pods/, and Xcode's own xcuserdata/dgph clutter — nested gitignores
# are respected by git regardless of directory depth, so those stay there
# rather than being duplicated here.

# Flutter/Dart build & tooling
app/.dart_tool/
app/.flutter-plugins-dependencies
app/.pub-cache/
app/.pub/
app/build/
app/coverage/
app/**/doc/api/
app/.widget_preview/

# Symbolication/obfuscation output
app/app.*.symbols
app/app.*.map.json

# IDE
app/.idea/
app/*.iml
app/*.ipr
app/*.iws
app/.atom/
app/.swiftpm/
app/migrate_working_dir/
